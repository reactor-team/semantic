    """Convert a comma-separated export into a columnar file on disk.

    Row-oriented text is read once and rewritten so that each field is stored
    together, which is what makes later analytical scans cheap.
    """
    return None


def infer_types(rows):
    """Guess whether each field holds numbers, dates, or free text."""
    return {}

-- deploy.yaml --
resources:
  limits:
    memory: 2Gi
    cpu: "1"
  requests:
    memory: 512Mi
probes:
  readiness:
    path: /healthz
    initialDelaySeconds: 5
